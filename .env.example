# Run python scripts/bootstrap.py to create random local secrets.
POSTGRES_PASSWORD=
CPF_HMAC_KEY=
WORKER_TOKEN=

# Local AI development profile.
# Semantic selection/review uses Ollama with the single approved local default.
AI_RUNTIME_PROFILE=LOCAL
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_SELECTION_MODEL=qwen3:8b
OLLAMA_REVIEW_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Keep fixture for fast CI/dev smoke tests; set faster-whisper for real local ASR.
WORKER_TARGET=base
TRANSCRIPTION_PROVIDER=fixture
FASTER_WHISPER_MODEL=medium
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=default

# Timestamped cloud transcription currently requires whisper-1.
TRANSCRIPTION_MODEL=whisper-1

# External credentials are never shipped. Configure Compose override for real integrations.

# Intelligent reframe. Keep disabled unless the worker image includes the vision provider.
TRACKING_ENABLED=false
VISION_PROVIDER=none
VISION_ALLOW_MODEL_DOWNLOAD=false
VISION_SAMPLE_FPS=2
VISION_MIN_CONFIDENCE=0.5
# MEDIAPIPE_FACE_MODEL=/models/blaze_face_short_range.tflite
# MEDIAPIPE_FACE_MODEL_SHA256=


# AI routing slots. Each stage can be changed independently later.
# TRANSCRIPTION_PROVIDER controls speech-to-text.
# OLLAMA_SELECTION_MODEL selects candidate moments.
# OLLAMA_REVIEW_MODEL performs the second-pass review.
# VISION_PROVIDER controls intelligent reframe.

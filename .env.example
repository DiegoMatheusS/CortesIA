# Run python scripts/bootstrap.py to create random local secrets.
POSTGRES_PASSWORD=
CPF_HMAC_KEY=
WORKER_TOKEN=

# Local AI development profile.
# Semantic selection/review uses Ollama with the single approved local default.
AI_RUNTIME_PROFILE=LOCAL
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SECONDS=180

# Keep fixture for fast CI/dev smoke tests; set faster-whisper for real local ASR.
WORKER_TARGET=base
TRANSCRIPTION_PROVIDER=fixture
FASTER_WHISPER_MODEL=medium
FASTER_WHISPER_DEVICE=auto
FASTER_WHISPER_COMPUTE_TYPE=default

# External credentials are never shipped. Configure Compose override for real integrations.
